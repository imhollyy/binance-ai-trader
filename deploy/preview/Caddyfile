{
    auto_https disable_redirects
    admin off
}

https://{$PREVIEW_HOST} {
    tls internal

    # Exact and ordered API path routing; no unrestricted API catch-all.
    # No "log" directive: never record raw paths, queries, cookies or CSRF.
    route {
        @api path /api/v1/*
        handle @api {
            reverse_proxy preview-api:8000 {
                # Only this private reverse proxy attests HTTPS to the API.
                header_up -Forwarded
                header_up -X-Forwarded-*
                header_up -X-Real-IP
                header_up Host {$PREVIEW_HOST}
                header_up X-Forwarded-Proto https
            }
        }

        @internal path /api/* /health/* /docs /redoc /openapi.json
        handle @internal {
            respond "Not found" 404
        }

        handle {
            reverse_proxy preview-web:3000
        }
    }
}
